# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local worker secrets (never commit)
.dev.vars

# Terraform. State can hold generated passwords and connection strings in clear,
# so it belongs in the remote backend and never in the repository — even the
# local state a `-backend=local` override produces while verifying a plan.
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfplan
backend.hcl
backend_override.tf

# The owner's source photographs, dropped here to be imported by
# scripts/import-product-images.ts. They are originals — tens of megabytes of
# them — and what the site serves is the optimized copy in blob storage, so the
# repository has no reason to carry either.
/PICTURES/
