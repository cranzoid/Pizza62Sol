# --- Database (Azure Database for PostgreSQL Flexible Server) ---
# Either a single URL, or the discrete PG* variables.
DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# Azure requires TLS; set to "disable" only for local development.
# PGSSLMODE=
# Replicas x pool size must stay under the server's connection limit.
# PGPOOL_MAX=10

# --- Object storage (Azure Blob Storage) ---
# Production uses the Container App's managed identity, so only the account name
# is needed. The connection string is the local/CI path (Azurite).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=uploads
# AZURE_STORAGE_CONNECTION_STRING=

# --- Delivery geocoding (Azure Maps) ---
# Delivery eligibility geocodes the street address instead of falling back to a
# postal-district centroid. Production uses the Container App's managed identity,
# so only the account's client id is needed; the subscription key is the local
# path. With neither set, the coarse FSA centroid table is used.
AZURE_MAPS_CLIENT_ID=
# AZURE_MAPS_SUBSCRIPTION_KEY=

# --- Proxy trust ---
# Set to "true" only where an ingress always stamps the caller's IP
# (X-Azure-ClientIP from Front Door, or X-Forwarded-For from Container Apps).
# Terraform sets this in Azure. Leave unset locally, or every request fails
# closed with a 429.
# TRUST_PROXY_HEADERS=

# --- Owner bootstrap ---
# Generate a unique high-entropy value (at least 24 characters) before first owner setup.
OWNER_SETUP_SECRET=

# --- Payments (Clover Hosted Checkout) ---
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_WEBHOOK_SECRET=
# "sandbox" or "production"
CLOVER_ENVIRONMENT=sandbox

# --- Notifications (Twilio) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Owner-set credentials ---------------------------------------------------
# Clover, Twilio and the email provider are normally set from Admin →
# Integrations, encrypted at rest under this key. Reads check the database first
# and fall back to these environment variables, so either route works — the admin
# screen exists so the owner can do it without an Azure login, and the variables
# exist so a developer can, without typing a payment token into a web form.
#
# openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# --- Background work ---------------------------------------------------------
# Shared with the timer that calls POST /api/cron/tick (a Logic App in Azure).
# Without it the endpoint refuses every request: an unauthenticated endpoint that
# dispatches notifications is a way to make the restaurant's phone ring from the
# internet.
CRON_SECRET=

# --- Search and advertising measurement ------------------------------------
# These identifiers are public by design. Tags remain disabled when blank and
# load only after the visitor allows optional measurement.
PUBLIC_BASE_URL=http://localhost:3000
SEO_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
