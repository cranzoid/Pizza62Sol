# Generate a unique high-entropy value (at least 24 characters) before first owner setup.
OWNER_SETUP_SECRET=

# Stripe hosted checkout. Leave blank until the Stripe account is ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email is provider-neutral. Add these after choosing a transactional provider.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
