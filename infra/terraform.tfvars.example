# Environment-specific values for Pizza 62.
#
# Copy to terraform.tfvars, which is gitignored.
#
# Nothing here is a secret — every credential lives in Key Vault or in the
# encrypted store the admin screen writes to. This file is committed as an
# example so the domain and the sizing are reviewable in a diff rather than
# living in one person's shell history, while the real file stays ignored so
# nobody can accidentally commit a secret into it later.

# ---------------------------------------------------------------------------
# The domain
#
# ⚠️  Leave both of these commented out until DNS is ready to move.
#
# Azure verifies the records at binding time and refuses the apply if they do not
# resolve — so with these set and DNS still at Wix, *every* apply fails, including
# ones that have nothing to do with the domain.
#
# The order is: apply without them → read `terraform output
# custom_domain_dns_records` and `apex_a_record_command` → create the records →
# wait for propagation → uncomment → apply again.
# ---------------------------------------------------------------------------
# custom_domain         = "pizza62.ca"
# custom_domain_aliases = ["www.pizza62.ca"]

# The sender address. Needs SPF and DKIM on pizza62.ca at the email provider
# before it will deliver; until then, override with the provider's sandbox sender.
email_from     = "orders@pizza62.ca"
email_provider = "resend"

# Sandbox until a test order has been through end to end.
clover_environment = "sandbox"

# ---------------------------------------------------------------------------
# The deploy pipeline
#
# Setting this creates the user-assigned identity the GitHub Actions workflow
# signs in as, plus the two federated credentials Azure checks its token
# against: one for a push to `main`, one for the `production` environment the
# deploy job runs in. Nothing here is a secret — there is no password to leak,
# only a trust relationship scoped to this repository.
#
# After applying, `terraform output github_actions_variables` prints the five
# repository variables `.github/workflows/deploy.yml` reads. Without them the
# workflow cannot sign in, and a push to `main` deploys nothing.
# ---------------------------------------------------------------------------
github_repository = "cranzoid/Pizza62Sol"
